# Environment name: local, ci, staging or production.
APP_ENV=local

# Password for the local/CI postgres service (compose refuses to start without it).
POSTGRES_PASSWORD=local-dev-only

# Direct/session connection, used by the CLI, migrations and tests.
DATABASE_URL=postgresql://postgres:local-dev-only@localhost:55432/cabosueltos

# Pooled connection used by the API. Falls back to DATABASE_URL when unset.
DATABASE_POOL_URL=

# Directory containing the built web app (apps/web/dist). Defaults to
# ../apps/web/dist relative to backend/ when unset.
WEB_DIST_DIR=

# Supabase project URL, used only by the staging Data API probe.
SUPABASE_URL=

# Supabase publishable key, used only by the staging Data API probe.
SUPABASE_PUBLISHABLE_KEY=
